{
  "name": "@powerhouse-ai/core",
  "version": "0.1.0",
  "description": "Core agent primitives for Powerhouse-AI — Claude-first TypeScript agent framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0",
    "eventsource-parser": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-ai/powerhouse-ai"
  }
}
